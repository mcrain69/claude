# ── AgencyZoom API ───────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Get your API key from:
#   AgencyZoom → Settings → Integrations → API Keys → Generate New Key
#
AZ_API_KEY=your_agencyzoom_api_key_here

# Optional: override the AgencyZoom base URL if using a sandbox/staging env
# AZ_BASE_URL=https://api.agencyzoom.com/v1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=agencyzoom_dashboard
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
